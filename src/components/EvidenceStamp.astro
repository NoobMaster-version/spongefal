---
/**
 * Evidence stamps: the measured metadata of a project.
 * Fixes the old site's missing-dates problem in the visual language.
 */
interface Props {
  dates: string;
  team: string;
  status: string;
  location?: string | undefined;
}
const { dates, team, status, location } = Astro.props;

const statusClass: Record<string, string> = {
  deployed: 'ok',
  validated: 'ok',
  teaching: 'ok',
  prototype: 'warn',
  wip: 'warn',
  retired: 'faint',
};
---

<dl class="stamps">
  <div class="stamp">
    <dt>Dates</dt>
    <dd>{dates}</dd>
  </div>
  <div class="stamp">
    <dt>Team</dt>
    <dd>{team}</dd>
  </div>
  {
    location && (
      <div class="stamp">
        <dt>Location</dt>
        <dd>{location}</dd>
      </div>
    )
  }
  <div class="stamp">
    <dt>Status</dt>
    <dd class={`stamp--${statusClass[status] ?? 'faint'}`}>{status}</dd>
  </div>
</dl>

<style>
  .stamps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: var(--sp-4) 0 var(--sp-6);
    font-family: var(--font-mono);
  }
  .stamp {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-3);
  }
  dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  dd {
    margin: 0;
    font-size: var(--text-sm);
    text-transform: uppercase;
  }
  .stamp--ok { color: var(--ok); }
  .stamp--warn { color: var(--warn); }
  .stamp--faint { color: var(--ink-faint); }
</style>
