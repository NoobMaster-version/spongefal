---
interface Props {
  src: string; // under /assets/
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
const { src, alt, caption, width, height } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure>
  <img src={`${base}/assets/${src}`} alt={alt} loading="lazy" decoding="async" width={width} height={height} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  img {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--surface-1);
  }
</style>
