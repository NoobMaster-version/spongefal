---
/**
 * The numbers a project earned, displayed like instrument readouts.
 */
interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---

<dl class="stat-hero">
  {
    stats.map((s) => (
      <div class="stat">
        <dd>{s.value}</dd>
        <dt>{s.label}</dt>
      </div>
    ))
  }
</dl>

<style>
  .stat-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--sp-3);
    margin: var(--sp-6) 0;
  }
  .stat {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: var(--sp-4);
    background: var(--surface-1);
  }
  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--signal);
    font-weight: 500;
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-top: var(--sp-1);
  }
</style>
