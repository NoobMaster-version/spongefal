---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'fleet'>;
  prev?: CollectionEntry<'fleet'> | undefined;
  next?: CollectionEntry<'fleet'> | undefined;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const info = [d.dates, d.team, d.location, d.status].filter(Boolean).join(' · ');
---

<Base title={d.title} description={d.summary}>
  <article class="container">
    <header class="cs-header">
      <h1>{d.title} <span class="what">({d.what})</span></h1>
      <p class="cs-summary">{d.summary}</p>
      {
        d.metric && (
          <p class="cs-metric">
            <span class="label cs-metric__k">what it earned</span>
            <span class="cs-metric__v">{d.metric}</span>
          </p>
        )
      }
      <p class="label">{info}</p>
      <div class="cs-links">
        {
          d.repo ? (
            <a class="btn" href={d.repo} target="_blank" rel="noopener">
              code ↗
            </a>
          ) : (
            d.repoNote && <span class="label cs-repo-note">{d.repoNote}</span>
          )
        }
        {d.links.map((l) => (
          <a class="btn" href={l.url} target="_blank" rel="noopener">
            {l.label} ↗
          </a>
        ))}
      </div>
    </header>

    <div class="cs-body prose">
      <slot />
    </div>

    <div class="cs-tech">
      <p class="label" id="built-with">made with</p>
      <ul aria-labelledby="built-with">
        {d.tech.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <nav class="berths" aria-label="More projects">
      {
        prev ? (
          <a href={`${base}/projects/${prev.id}/`} rel="prev">
            <span class="label">← previous</span>
            <span>{prev.data.title} <span class="what">({prev.data.what})</span></span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`${base}/projects/${next.id}/`} rel="next" class="berths__next">
            <span class="label">next →</span>
            <span>{next.data.title} <span class="what">({next.data.what})</span></span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<style>
  .cs-header {
    padding-top: var(--sp-12);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--sp-8);
  }
  .cs-summary {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  /* the plain-language descriptor — quieter than the name it explains */
  .what {
    color: var(--ink-faint);
    font-weight: 400;
    font-size: 0.82em;
    letter-spacing: 0;
    white-space: nowrap;
  }
  /* the h1 runs up to 3rem, so the descriptor needs to shrink harder there */
  .cs-header h1 .what { font-size: 0.46em; }
  .cs-metric {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 2px solid var(--signal);
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-3);
    margin-block: var(--sp-4);
    max-width: var(--measure);
  }
  .cs-metric__k { color: var(--ink-faint); }
  .cs-metric__v {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-variant-numeric: tabular-nums;
    color: var(--signal);
  }
  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
    margin-block: var(--sp-4) var(--sp-6);
  }
  .cs-repo-note {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    padding: var(--sp-2) var(--sp-3);
  }
  .cs-tech ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    max-width: none;
  }
  .cs-tech li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-3);
    color: var(--ink-soft);
  }
  .berths {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: var(--sp-16);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-6);
  }
  .berths a {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    text-decoration: none;
    color: var(--ink);
    max-width: 40ch;
  }
  .berths a:hover span:last-child { color: var(--signal); }
  .berths__next { text-align: right; margin-left: auto; }
</style>
