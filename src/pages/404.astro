---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — signal lost" description="Page not found.">
  <div class="container lost">
    <p class="label">ERR · localization failure</p>
    <h1>Signal lost</h1>
    <p class="prose">
      This page isn't in the map. Either it never existed, or it moved during
      the rebuild. The robot has re-planned a route back:
    </p>
    <p class="lost-route label" aria-hidden="true">
      [you] ─┐<br />
      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;└──→ replanning… ──→ [dock]
    </p>
    <div class="lost-actions">
      <a class="btn btn--primary" href={`${base}/`}>Return to dock</a>
      <a class="btn" href={`${base}/fleet/`}>Browse the fleet</a>
    </div>
  </div>

  <style>
    .lost { padding-top: var(--sp-24); }
    .lost-route {
      color: var(--warn);
      margin-block: var(--sp-6);
      line-height: 1.8;
    }
    .lost-actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  </style>
</Base>
