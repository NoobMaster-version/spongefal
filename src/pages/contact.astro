---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="contact" description="Say hi. Email, LinkedIn, GitHub, resume.">
  <div class="container">
    <header class="ct-head">
      <h1>say hi</h1>
      <p class="prose">
        Have an idea, a robot, or a question? Write to me. Midnight is fine.
      </p>
    </header>

    <div class="channels">
      <a class="channel panel" href="mailto:krpathak@proton.me">
        <span class="label">email</span>
        <span class="channel__v">krpathak@proton.me</span>
      </a>
      <a class="channel panel" href="https://www.linkedin.com/in/kartikey-pathak-a365a8281/" target="_blank" rel="noopener">
        <span class="label">linkedin</span>
        <span class="channel__v">kartikey-pathak ↗</span>
      </a>
      <a class="channel panel" href="https://github.com/NoobMaster-version" target="_blank" rel="noopener">
        <span class="label">github</span>
        <span class="channel__v">NoobMaster-version ↗</span>
      </a>
    </div>

    <div class="resume-row">
      <a class="btn btn--primary" href={`${base}/resume.pdf`}>resume (PDF)</a>
      <a class="btn" href={`${base}/plain/`}>everything on one page</a>
    </div>
  </div>

  <style>
    .ct-head { padding-top: var(--sp-12); }
    .channels {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--sp-4);
      margin-block: var(--sp-8);
    }
    .channel {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      text-decoration: none;
      transition: border-color var(--t-fast) var(--e-mech), box-shadow var(--t-fast) var(--e-mech);
    }
    .channel:hover,
    .channel:focus-visible {
      border-color: var(--signal);
      box-shadow: var(--glow);
    }
    .channel__v {
      font-family: var(--font-mono);
      color: var(--ink);
      overflow-wrap: anywhere;
    }
    .resume-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }
  </style>
</Base>
