---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const fleet = (await getCollection('fleet')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const spotlight = fleet.map((e) => {
  const clip = e.data.homeVideo ?? e.data.video;
  return {
    id: e.id,
    href: `${base}/projects/${e.id}/`,
    title: e.data.homeLabel ?? `${e.data.title} (${e.data.what})`,
    poster: `${base}/assets/${e.data.homePoster ?? e.data.poster}`,
    video: clip ? `${base}/assets/${clip}` : null,
    hint: e.data.metric ?? '',
  };
});

// Which slot opens the reel, in eighths. The rest of the weight goes to a
// random pick from everything not listed here, so the older work still shows up.
const OPENING_ODDS = [
  { id: 'eyecandy', eighths: 3 },
  { id: 'axial-flux-motor', eighths: 2 },
];

// No-JS (and first paint) gets the one I'd pick myself.
const first =
  spotlight.find((s) => s.id === OPENING_ODDS[0]!.id) ??
  spotlight.find((s) => s.video) ??
  spotlight[0]!;

// the four I'd show someone first — newest and hardest at the top
const featured = fleet
  .filter((e) => e.data.featured)
  .sort((a, b) => b.data.order - a.data.order);
---

<Base title="hi" description="Kartikey Pathak. I build robots. This site is the stuff I've made.">
  <div class="container">
    <section class="hero">
      <div class="hero__text">
        <h1 class="hero__name">hi, I'm Kartikey</h1>
        <p class="hero__thesis">
          I'm an electrical engineering student at VJTI, Mumbai. I build
          robots. They usually work in the end.
        </p>
        <p class="hero__thesis hero__sub">
          This site is the stuff I've made. Poke around — there are some toys
          hidden in here.
        </p>
        <p class="hero__status label">
          <span class="blip" aria-hidden="true"></span>
          right now: a motor with no iron in it · call me at midnight with an idea
        </p>
      </div>

      {/* The screen is the link; the arrows are buttons beside it, because a
          <button> cannot legally live inside an <a>. */}
      <div class="spotlight">
        <div class="spotlight__bar">
          <span class="label spotlight__now" aria-live="polite">
            on the bench right now → <span id="spot-title">{first.title}</span>
          </span>
          <span class="spotlight__nav">
            <button type="button" class="spot-btn" id="spot-prev" aria-label="Previous project">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  d="M10 3 5 8l5 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <span class="spotlight__count" id="spot-count">1/{spotlight.length}</span>
            <button type="button" class="spot-btn" id="spot-next" aria-label="Next project">
              <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  d="M6 3l5 5-5 5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </span>
        </div>
        <a class="spotlight__screen" id="spotlight-link" href={first.href} aria-label={`Open ${first.title}`}>
          <video
            id="spot-video"
            muted
            loop
            playsinline
            autoplay
            preload="metadata"
            poster={first.poster}
            aria-hidden="true"
          >
            {first.video && <source src={first.video} type="video/mp4" />}
          </video>
          <span class="label spotlight__hint" id="spot-hint">{first.hint}</span>
        </a>
      </div>
      <script type="application/json" id="spotlight-data" set:html={JSON.stringify(spotlight)} />
      <script type="application/json" id="spotlight-odds" set:html={JSON.stringify(OPENING_ODDS)} />
    </section>

    <section class="pick" aria-labelledby="pick-h">
      <h2 id="pick-h" class="pick__h">start here</h2>
      <p class="label">the four I'd show you first</p>
      <ul class="pick-grid" role="list">
        {
          featured.map((e) => (
            <li>
              <a href={`${base}/projects/${e.id}/`}>
                <span class="pick-card__screen">
                  {e.data.video ? (
                    <video
                      muted
                      loop
                      playsinline
                      preload="none"
                      data-pick-loop
                      width="640"
                      height="400"
                      poster={`${base}/assets/${e.data.poster}`}
                      aria-hidden="true"
                    >
                      <source src={`${base}/assets/${e.data.video}`} type="video/mp4" />
                    </video>
                  ) : (
                    <img
                      src={`${base}/assets/${e.data.poster}`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="400"
                    />
                  )}
                </span>
                <span class="pick-card__t">
                  {e.data.title} <span class="what">({e.data.what})</span>
                </span>
                {e.data.metric && <span class="pick-card__metric">{e.data.metric}</span>}
                <span class="pick-card__s">{e.data.summary}</span>
                <span class="pick-card__meta label">
                  {e.data.dates} · {e.data.status}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="bench" aria-labelledby="bench-h">
      <h2 id="bench-h" class="bench__h">everything</h2>
      <p class="label">
        all {fleet.length} of them, roughly in the order I built them · reload the
        page for a different robot above
      </p>
      <ul class="bench-strip" role="list">
        {
          fleet.map((e) => (
            <li>
              <a href={`${base}/projects/${e.id}/`}>
                <img
                  src={`${base}/assets/${e.data.poster}`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
                <span class="bench-strip__t">
                  {e.data.title} <span class="what">({e.data.what})</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="also prose">
      <p>
        Also: I run robot workshops at <a href={`${base}/about/`}>SRA</a>,
        made a short film with friends once (it won), and our lab cat has{' '}
        <a href={`${base}/projects/robots-for-good/`}>her own robot</a>.
      </p>
      <p class="label">
        the story so far → <a href={`${base}/log/`}>the log</a> ·
        want to talk? → <a href={`${base}/contact/`}>contact</a>
      </p>
    </section>
  </div>

  <script>
    // A different machine on the bench every visit, and arrows to page through
    // the rest by hand.
    type Spot = {
      id: string;
      href: string;
      title: string;
      poster: string;
      video: string | null;
      hint: string;
    };
    type Odds = { id: string; eighths: number };

    const data = document.getElementById('spotlight-data');
    const oddsEl = document.getElementById('spotlight-odds');
    const link = document.getElementById('spotlight-link') as HTMLAnchorElement | null;
    const video = document.getElementById('spot-video') as HTMLVideoElement | null;

    if (data && link && video) {
      const spots: Spot[] = JSON.parse(data.textContent ?? '[]');
      const odds: Odds[] = JSON.parse(oddsEl?.textContent ?? '[]');
      const titleEl = document.getElementById('spot-title')!;
      const hintEl = document.getElementById('spot-hint')!;
      const countEl = document.getElementById('spot-count')!;

      // Weighted opening pick. The listed ids get their share of eighths; the
      // remainder is split evenly over everything else, so the back catalogue
      // still turns up instead of only ever showing the two newest.
      const openingIndex = () => {
        const total = 8;
        let roll = Math.random() * total;
        for (const o of odds) {
          roll -= o.eighths;
          if (roll < 0) {
            const i = spots.findIndex((s) => s.id === o.id);
            if (i >= 0) return i;
          }
        }
        const rest = spots
          .map((_, i) => i)
          .filter((i) => !odds.some((o) => o.id === spots[i]!.id));
        if (!rest.length) return 0;
        return rest[Math.floor(Math.random() * rest.length)]!;
      };

      let at = openingIndex();

      const show = (i: number) => {
        at = (i + spots.length) % spots.length;
        const pick = spots[at]!;
        link.href = pick.href;
        link.setAttribute('aria-label', `Open ${pick.title}`);
        titleEl.textContent = pick.title;
        hintEl.textContent = pick.hint;
        countEl.textContent = `${at + 1}/${spots.length}`;
        video.poster = pick.poster;
        video.innerHTML = '';
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const plain = document.documentElement.classList.contains('plain');
        if (pick.video && !reduce && !plain) {
          const s = document.createElement('source');
          s.src = pick.video;
          s.type = 'video/mp4';
          video.appendChild(s);
          video.load();
          video.play().catch(() => {});
        } else {
          video.load();
        }
      };

      show(at);
      document.getElementById('spot-prev')?.addEventListener('click', () => show(at - 1));
      document.getElementById('spot-next')?.addEventListener('click', () => show(at + 1));
    }

    // featured cards: loop only while on screen, and never under reduced motion
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            const plain = document.documentElement.classList.contains('plain');
            if (e.isIntersecting && !plain) v.play().catch(() => {});
            else v.pause();
          }),
        { threshold: 0.3 }
      );
      document
        .querySelectorAll<HTMLVideoElement>('video[data-pick-loop]')
        .forEach((v) => io.observe(v));
    }
  </script>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--sp-8);
      align-items: center;
      padding-block: var(--sp-16) var(--sp-8);
    }
    .hero__name {
      font-size: var(--text-hero);
      letter-spacing: -0.02em;
      margin: 0 0 var(--sp-4);
    }
    .hero__thesis {
      font-size: var(--text-lg);
      color: var(--ink-soft);
      max-width: 40ch;
    }
    .hero__sub {
      font-size: var(--text-md);
      color: var(--ink-faint);
    }
    .hero__status {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      margin-top: var(--sp-6);
    }
    .blip {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--ok);
      box-shadow: 0 0 8px var(--ok);
      flex-shrink: 0;
    }
    .spotlight {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      text-decoration: none;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: var(--surface-1);
      padding: var(--sp-3);
      transition: border-color var(--t-fast) var(--e-mech), box-shadow var(--t-fast) var(--e-mech);
    }
    /* focus-within, not focus-visible: the focusable parts are now inside */
    .spotlight:hover,
    .spotlight:focus-within {
      border-color: var(--signal);
      box-shadow: var(--glow);
    }
    .spotlight__bar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--sp-3);
    }
    .spotlight__now { color: var(--signal); text-transform: none; min-width: 0; }
    .spotlight__nav {
      display: flex;
      align-items: center;
      gap: var(--sp-1);
      flex-shrink: 0;
    }
    .spot-btn {
      position: relative;
      display: inline-grid;
      place-items: center;
      width: 26px;
      height: 26px;
      padding: 0;
      color: var(--ink-soft);
      background: none;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: color var(--t-fast) var(--e-mech), border-color var(--t-fast) var(--e-mech);
    }
    /* 26px reads right but is a poor thumb target — grow the hit area, not the box */
    .spot-btn::after {
      content: '';
      position: absolute;
      inset: -9px;
    }
    .spot-btn svg { width: 14px; height: 14px; display: block; }
    .spot-btn:hover {
      color: var(--signal);
      border-color: var(--signal);
    }
    .spotlight__count {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-variant-numeric: tabular-nums;
      color: var(--ink-faint);
      min-width: 3.5ch;
      text-align: center;
    }
    .spotlight__screen {
      position: relative;
      display: block;
      text-decoration: none;
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--surface-0);
    }
    .spotlight__screen video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border: none;
      border-radius: 0;
    }
    .spotlight__hint {
      position: absolute;
      left: var(--sp-2);
      bottom: var(--sp-2);
      padding: 2px var(--sp-2);
      background: rgb(0 0 0 / 0.55);
      border-radius: var(--radius-sm);
      color: var(--ink);
      text-transform: none;
    }
    /* ---- start here: the four cards ---- */
    .pick { margin-top: var(--sp-8); }
    .pick__h { margin-top: 0; }
    .pick-grid {
      list-style: none;
      padding: 0;
      margin: var(--sp-4) 0 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--sp-4);
      max-width: none;
    }
    .pick-grid a {
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
      color: var(--ink);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-1);
      padding: var(--sp-3);
      transition: border-color var(--t-fast) var(--e-mech), box-shadow var(--t-fast) var(--e-mech);
    }
    .pick-grid a:hover,
    .pick-grid a:focus-visible {
      border-color: var(--signal);
      box-shadow: var(--glow);
    }
    .pick-card__screen {
      position: relative;
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-sm);
      border: 1px solid var(--line);
      background: var(--surface-0);
    }
    .pick-card__screen :is(video, img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: none;
      border-radius: 0;
    }
    .pick-card__t {
      display: block;
      font-weight: 600;
      font-size: var(--text-lg);
      line-height: 1.2;
      margin-top: var(--sp-3);
      text-wrap: balance;
    }
    /* the plain-language descriptor — quieter than the name it explains */
    .what {
      color: var(--ink-faint);
      font-weight: 400;
      font-size: 0.82em;
      white-space: nowrap;
    }
    .pick-card__metric {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
      color: var(--signal);
      margin-top: var(--sp-1);
    }
    .pick-card__s {
      display: block;
      margin-top: var(--sp-2);
      color: var(--ink-soft);
      font-size: var(--text-sm);
    }
    .pick-card__meta { display: block; margin-top: auto; padding-top: var(--sp-3); }

    .bench { margin-top: var(--sp-16); }
    .bench__h { margin-top: 0; }
    .bench-strip {
      list-style: none;
      padding: 0;
      margin: var(--sp-4) 0 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: var(--sp-3);
      max-width: none;
    }
    .bench-strip a {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      text-decoration: none;
      color: var(--ink);
    }
    .bench-strip img {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      width: 100%;
      border: 1px solid var(--line);
      transition: border-color var(--t-fast) var(--e-mech);
    }
    .bench-strip a:hover img,
    .bench-strip a:focus-visible img {
      border-color: var(--signal);
    }
    .bench-strip__t { font-size: var(--text-sm); line-height: 1.3; }
    .also { margin-top: var(--sp-12); }
    @media (max-width: 920px) {
      .hero { grid-template-columns: 1fr; padding-top: var(--sp-8); }
    }
  </style>
</Base>
