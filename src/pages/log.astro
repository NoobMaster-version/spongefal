---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// my life as a changelog. + shipped, - dropped, ~ in progress
const releases = [
  {
    v: 'v0.1',
    date: 'dec 2023',
    title: 'first robot',
    notes: [
      '+ gesture-controlled car (winter internship, semester 1)',
      '+ learned: sensors lie until you filter them',
    ],
    link: 'origins',
  },
  {
    v: 'v0.5',
    date: '2024',
    title: 'control systems',
    notes: [
      '+ wall-e (self-balancing) and the maze solver — 4th place',
      '+ joined SRA, started teaching what I had just learned',
    ],
    link: 'origins',
  },
  {
    v: 'v1.0',
    date: 'jun 2024',
    title: 'ROS2',
    notes: [
      '+ VVM: voice → vision → robot arm',
      '- writing robots as one big loop',
    ],
    link: 'vvm',
  },
  {
    v: 'v1.2',
    date: 'jul 2024',
    title: 'MARIO',
    notes: [
      '+ ported the teaching arm off a dead simulator',
      '+ it still runs the ROS2 workshops',
    ],
    link: 'mario',
  },
  {
    v: 'v2.0',
    date: 'oct 2024',
    title: 'flying',
    notes: [
      '+ e-Yantra warehouse drone, national semifinals',
      '+ learned: camera-only localization is fragile (this comes back later)',
    ],
    link: 'eyantra',
  },
  {
    v: 'v2.5',
    date: '2024 – 2025',
    title: 'side quests',
    notes: [
      '+ kurma the turtle robot',
      '+ coin sorter in a 24-hour hackathon',
      '+ one cat feeder',
    ],
    link: 'kurma',
  },
  {
    v: 'v3.0',
    date: 'may 2025',
    title: 'the forklift',
    notes: [
      '+ defence research internship at IIT Gandhinagar',
      '+ wrote our own UWB ranging firmware: 45 m stock limit → 315 m',
      '+ 0.4% error over 10,000 m², checked against a total station',
    ],
    link: 'kdail',
  },
  {
    v: 'v3.2',
    date: 'may – nov 2025',
    title: 'the wheelchair',
    notes: [
      '+ NishCorp internship: CAD → simulation → half-scale prototype',
    ],
    link: 'nishcorp',
  },
  {
    v: 'v4.0',
    date: '2025 – 2026',
    title: 'the smart switch',
    notes: [
      '+ hardware, firmware, cloud, app — all of it',
      '+ started as a hobby, trying to make it a real product',
    ],
    link: 'smart-switch',
  },
  {
    v: 'HEAD',
    date: 'now',
    title: 'in progress',
    notes: [
      '~ open-sourcing the cat feeder',
      '~ smart switch: perf board → real PCB, OTA updates',
      '~ known issue: cannot stop building robots. won\'t fix.',
    ],
    link: null,
  },
];
---

<Base title="log" description="The story so far, written as a changelog.">
  <div class="container">
    <header class="tl-head">
      <h1>log</h1>
      <p class="prose">
        The story so far, as a changelog. <code>+</code> shipped,
        <code>-</code> dropped, <code>~</code> in progress.
      </p>
    </header>

    <ol class="releases" role="list">
      {
        releases.map((r) => (
          <li class="release">
            <div class="release__meta">
              <span class="release__v">{r.v}</span>
              <span class="label">{r.date}</span>
            </div>
            <div class="release__body panel">
              <h2>{r.title}</h2>
              <ul class="release__notes">
                {r.notes.map((n) => (
                  <li class={n.startsWith('+') ? 'add' : n.startsWith('-') ? 'del' : 'wip'}>
                    {n}
                  </li>
                ))}
              </ul>
              {r.link && <a class="label" href={`${base}/projects/${r.link}/`}>see it →</a>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <style>
    .tl-head { padding-top: var(--sp-12); }
    .releases {
      list-style: none;
      padding: 0;
      margin-top: var(--sp-8);
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
    }
    .release {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: var(--sp-6);
    }
    .release__meta {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      padding-top: var(--sp-4);
    }
    .release__v {
      font-family: var(--font-mono);
      font-size: var(--text-lg);
      color: var(--signal);
      font-weight: 500;
    }
    .release__body h2 {
      margin: 0 0 var(--sp-3);
      font-size: var(--text-lg);
    }
    .release__notes {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--sp-3);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
    }
    .release__notes .add { color: var(--ok); }
    .release__notes .del { color: var(--alert); }
    .release__notes .wip { color: var(--warn); }
    @media (max-width: 768px) {
      .release { grid-template-columns: 1fr; gap: var(--sp-2); }
      .release__meta { flex-direction: row; align-items: baseline; gap: var(--sp-3); padding-top: 0; }
    }
  </style>
</Base>
