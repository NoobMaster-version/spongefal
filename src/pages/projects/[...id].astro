---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const fleet = (await getCollection('fleet')).sort((a, b) => a.data.order - b.data.order);
  return fleet.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: fleet[i - 1], next: fleet[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudy entry={entry} prev={prev} next={next}>
  <Content />
</CaseStudy>
