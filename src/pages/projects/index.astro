---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const fleet = (await getCollection('fleet')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="projects" description="Everything I've built, with videos. Roughly in the order I built it.">
  <div class="container">
    <header class="pj-head">
      <h1>projects</h1>
      <p class="prose">
        Everything here physically exists (or existed). There's a video on
        every page — seeing a thing move beats reading about it.
      </p>
      <p class="label">{fleet.length} of them, roughly in the order I built them</p>
    </header>

    <ol class="wall" role="list">
      {
        fleet.map((entry) => (
          <li class="monitor">
            <a href={`${base}/projects/${entry.id}/`}>
              <span class="monitor__screen">
                {entry.data.video ? (
                  <video
                    muted
                    loop
                    playsinline
                    preload="none"
                    data-wall-loop
                    width="640"
                    height="400"
                    poster={`${base}/assets/${entry.data.poster}`}
                    aria-hidden="true"
                  >
                    <source src={`${base}/assets/${entry.data.video}`} type="video/mp4" />
                  </video>
                ) : (
                  <img
                    src={`${base}/assets/${entry.data.poster}`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="400"
                  />
                )}
                <span class="monitor__status">{entry.data.status}</span>
              </span>
              <span class="monitor__title">
                {entry.data.title} <span class="what">({entry.data.what})</span>
              </span>
              {entry.data.metric && (
                <span class="monitor__metric">{entry.data.metric}</span>
              )}
              <span class="monitor__summary">{entry.data.summary}</span>
              <span class="monitor__meta label">{entry.data.dates}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            const plain = document.documentElement.classList.contains('plain');
            if (e.isIntersecting && !plain) v.play().catch(() => {});
            else v.pause();
          }),
        { threshold: 0.3 }
      );
      document
        .querySelectorAll<HTMLVideoElement>('video[data-wall-loop]')
        .forEach((v) => io.observe(v));
    }
  </script>

  <style>
    .pj-head { padding-top: var(--sp-12); }
    .wall {
      list-style: none;
      padding: 0;
      display: grid;
      /* three up on a laptop, one up on a phone. Without max-width:none this
         <ol> inherits the 68ch prose measure from base.css and only fits two. */
      grid-template-columns: repeat(3, 1fr);
      max-width: none;
      gap: var(--sp-6);
      margin-top: var(--sp-8);
    }
    @media (max-width: 1000px) {
      .wall { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 680px) {
      .wall { grid-template-columns: 1fr; }
    }
    .monitor a {
      display: block;
      text-decoration: none;
      color: var(--ink);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-1);
      padding: var(--sp-3);
      height: 100%;
      transition: border-color var(--t-fast) var(--e-mech), box-shadow var(--t-fast) var(--e-mech);
    }
    .monitor a:hover,
    .monitor a:focus-visible {
      border-color: var(--signal);
      box-shadow: var(--glow);
    }
    .monitor__screen {
      position: relative;
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-sm);
      border: 1px solid var(--line);
      background: var(--surface-0);
    }
    .monitor__screen :is(video, img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: none;
      border-radius: 0;
    }
    .monitor__status {
      position: absolute;
      top: var(--sp-2);
      right: var(--sp-2);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.06em;
      padding: 2px var(--sp-2);
      border-radius: var(--radius-sm);
      background: rgb(0 0 0 / 0.55);
      color: var(--ink-soft);
    }
    .monitor__title {
      display: block;
      font-weight: 600;
      font-size: var(--text-lg);
      margin-top: var(--sp-3);
    }
    /* the plain-language descriptor — quieter than the name it explains */
    .what {
      color: var(--ink-faint);
      font-weight: 400;
      font-size: 0.78em;
      white-space: nowrap;
    }
    .monitor__metric {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.04em;
      font-variant-numeric: tabular-nums;
      color: var(--signal);
      margin-top: var(--sp-1);
    }
    .monitor__summary {
      display: block;
      margin-top: var(--sp-2);
      color: var(--ink-soft);
      font-size: var(--text-sm);
    }
    .monitor__meta { display: block; margin-top: var(--sp-2); }
  </style>
</Base>
