---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Uplink" description="Contact Kartikey Pathak — email, LinkedIn, GitHub, resume.">
  <div class="container">
    <header class="up-head">
      <p class="label">/uplink · channels open</p>
      <h1>Get in touch</h1>
      <p class="prose">
        Looking for someone who can take a robot from URDF to the warehouse
        floor? Or just have an idea at midnight? Either works.
      </p>
    </header>

    <div class="channels">
      <a class="channel panel" href="mailto:kartikeypathak.imp@gmail.com">
        <span class="label">primary channel</span>
        <span class="channel__v">kartikeypathak.imp@gmail.com</span>
      </a>
      <a class="channel panel" href="mailto:krpathak_b23@el.vjti.ac.in">
        <span class="label">institutional</span>
        <span class="channel__v">krpathak_b23@el.vjti.ac.in</span>
      </a>
      <a class="channel panel" href="https://www.linkedin.com/in/kartikey-pathak-a365a8281/" target="_blank" rel="noopener">
        <span class="label">linkedin</span>
        <span class="channel__v">kartikey-pathak ↗</span>
      </a>
      <a class="channel panel" href="https://github.com/NoobMaster-version" target="_blank" rel="noopener">
        <span class="label">github</span>
        <span class="channel__v">NoobMaster-version ↗</span>
      </a>
    </div>

    <div class="resume-row">
      <a class="btn btn--primary" href={`${base}/resume.pdf`}>Download resume (PDF)</a>
      <a class="btn" href={`${base}/recruiter/`}>60-second recruiter view</a>
    </div>
  </div>

  <style>
    .up-head { padding-top: var(--sp-12); }
    .channels {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--sp-4);
      margin-block: var(--sp-8);
    }
    .channel {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      text-decoration: none;
      transition: border-color var(--t-fast) var(--e-mech), box-shadow var(--t-fast) var(--e-mech);
    }
    .channel:hover,
    .channel:focus-visible {
      border-color: var(--signal);
      box-shadow: var(--glow);
    }
    .channel__v {
      font-family: var(--font-mono);
      color: var(--ink);
      overflow-wrap: anywhere;
    }
    .resume-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }
  </style>
</Base>
